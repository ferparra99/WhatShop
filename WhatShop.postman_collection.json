{
  "info": {
    "name": "WhatShop API",
    "description": "Coleccion de endpoints del marketplace WhatShop.\n\n## Autenticacion\n1. Ejecutar **Register** o **Login** (publicos)\n2. El token se guarda automaticamente en la variable `token`\n3. Los endpoints protegidos lo usan via `Authorization: Bearer {{token}}`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "opencode"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "sellerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Endpoints de autenticacion — registro, login, perfil propio y renovacion de token",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.token) {",
                  "        pm.collectionVariables.set('token', jsonData.data.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"comprador@email.com\",\n  \"password\": \"123456\",\n  \"fullName\": \"Juan Perez\",\n  \"phone\": \"+573001234567\",\n  \"role\": \"BUYER\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.token) {",
                  "        pm.collectionVariables.set('token', jsonData.data.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"comprador@email.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Get My Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "description": "Gestion del perfil del comprador",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me"]
            }
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Juan Perez Actualizado\",\n  \"phone\": \"+573001234568\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Sellers",
      "item": [
        {
          "name": "Publico",
          "item": [
            {
              "name": "List Active Sellers",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/api/v1/sellers",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "sellers"]
                }
              }
            },
            {
              "name": "Get Seller by ID",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/api/v1/sellers/{{sellerId}}",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "sellers", "{{sellerId}}"]
                }
              }
            }
          ]
        },
        {
          "name": "Propio (SELLER)",
          "item": [
            {
              "name": "Get My Seller Profile",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/api/v1/sellers/me",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "sellers", "me"]
                }
              }
            },
            {
              "name": "Update My Store",
              "request": {
                "method": "PUT",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"storeName\": \"Mi Tienda\",\n  \"description\": \"Venta de productos electronicos\",\n  \"nit\": \"900123456-7\",\n  \"logoUrl\": \"https://ejemplo.com/logo.png\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/sellers/me",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "sellers", "me"]
                }
              }
            },
            {
              "name": "Get My Products (Seller)",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/api/v1/sellers/me/products?page=0&size=10",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "sellers", "me", "products"],
                  "query": [
                    { "key": "page", "value": "0" },
                    { "key": "size", "value": "10" }
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Publico",
          "item": [
            {
              "name": "List Products",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/api/v1/products?page=0&size=10",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "products"],
                  "query": [
                    { "key": "page", "value": "0" },
                    { "key": "size", "value": "10" }
                  ]
                }
              }
            },
            {
              "name": "Get Product Detail",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/api/v1/products/{{productId}}",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "products", "{{productId}}"]
                }
              }
            },
            {
              "name": "Search Products",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/api/v1/products/search?q=smartphone&page=0&size=10",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "products", "search"],
                  "query": [
                    { "key": "q", "value": "smartphone" },
                    { "key": "page", "value": "0" },
                    { "key": "size", "value": "10" }
                  ]
                }
              }
            },
            {
              "name": "List Products with Filters",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{base_url}}/api/v1/products?categoryId={{categoryId}}&minPrice=10.00&maxPrice=500.00&page=0&size=10",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "products"],
                  "query": [
                    { "key": "categoryId", "value": "{{categoryId}}" },
                    { "key": "minPrice", "value": "10.00" },
                    { "key": "maxPrice", "value": "500.00" },
                    { "key": "page", "value": "0" },
                    { "key": "size", "value": "10" }
                  ]
                }
              }
            }
          ]
        },
        {
          "name": "Seller (SELLER)",
          "item": [
            {
              "name": "Create Product",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Smartphone Pro Max\",\n  \"description\": \"Telefono de alta gama con 256GB\",\n  \"price\": 499.99,\n  \"stock\": 50,\n  \"categoryId\": \"{{categoryId}}\",\n  \"imageUrl\": \"https://ejemplo.com/smartphone.png\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/products",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "products"]
                }
              }
            },
            {
              "name": "Update Product",
              "request": {
                "method": "PUT",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Smartphone Pro Max Plus\",\n  \"description\": \"Telefono de alta gama con 512GB\",\n  \"price\": 599.99,\n  \"stock\": 30,\n  \"categoryId\": \"{{categoryId}}\",\n  \"imageUrl\": \"https://ejemplo.com/smartphone-plus.png\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/products/{{productId}}",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "products", "{{productId}}"]
                }
              }
            },
            {
              "name": "Delete Product",
              "request": {
                "method": "DELETE",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": {
                  "raw": "{{base_url}}/api/v1/products/{{productId}}",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "products", "{{productId}}"]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/categories",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "categories"]
            }
          }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronicos\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/categories",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "categories"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "description": "Administracion — solo accesible con rol ADMIN",
      "item": [
        {
          "name": "List All Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/users",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "users"]
            }
          }
        },
        {
          "name": "Toggle User Enabled",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/users/{{userId}}/enable",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "users", "{{userId}}", "enable"]
            }
          }
        }
      ]
    }
  ]
}

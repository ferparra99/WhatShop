              "  pm.collectionVariables.set('userId', res.data.userId);",
              "  console.log('✅ Login OK — rol:', res.data.role);",
              "  pm.test('Login exitoso', () => pm.response.to.have.status(200));",
              "  pm.test('Token recibido', () => pm.expect(res.data.token).to.be.a('string'));",
              "}"
            ], "type": "text/javascript" }
